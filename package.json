{
  "name": "latrunculi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^24.0.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests --exclude '**/*.simulation.test.ts'",
    "build": "tsc --project tsconfig.build.json && vite build",
    "simulate": "vitest run --reporter=default tests/random.simulation.test.ts",
    "diagnose": "vitest run --reporter=default tests/gameplay.simulation.test.ts",
    "dev": "vite",
    "preview": "vite preview",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "31.0.1",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vitest": "4.1.12"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
